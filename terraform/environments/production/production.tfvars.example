# Copy this file to terraform.tfvars and fill in the values.
# NEVER commit the actual .tfvars file — it is already in .gitignore.
#
# Production environment — full HA configuration.
# Multi-AZ NAT, Multi-AZ OpenSearch, Multi-AZ RDS, deletion protection.
#
# Before applying, bootstrap the state backend:
#   cd ../../bootstrap/production
#   terraform init
#   terraform apply -var-file=production.tfvars
#   # Copy outputs into environments/production/main.tf backend block

project_name = "healing"
environment  = "production"
cluster_name = "healing-production"
aws_region   = "us-east-1"

# Networking — one NAT per AZ for HA
vpc_cidr           = "10.0.0.0/16"
single_nat_gateway = false

# EKS
kubernetes_version  = "1.35"
node_instance_types = ["t3.medium"]
node_min_size       = 3
node_max_size       = 6
node_desired_size   = 3

# ECR — no force delete in production
ecr_repository_name = "REPLACE-WITH-YOUR-ECR-REPO"
ecr_force_delete    = false

# GitHub OIDC
github_org   = "REPLACE-WITH-YOUR-GITHUB-ORG"
github_repos = ["REPLACE-WITH-YOUR-REPO"]

# DNS — get shared_state_bucket from: terraform -chdir=../../bootstrap/shared output
shared_state_bucket = "REPLACE-WITH-SHARED-STATE-BUCKET"
dns_records         = ["api.example.com"]

# OpenSearch — Multi-AZ, 3 nodes across 3 AZs
opensearch_engine_version             = "OpenSearch_2.17"
opensearch_instance_type              = "r6g.large.search"
opensearch_instance_count             = 3
opensearch_ebs_volume_size            = 100
opensearch_zone_awareness_enabled     = true
opensearch_availability_zone_count    = 3
opensearch_dedicated_master_enabled   = false
opensearch_create_service_linked_role = false  # set to true ONLY if the SLR doesn't exist yet in your account

# SQS / Workload Identity — Healing Specialist
sqs_healing_k8s_namespace       = "healing"
sqs_healing_k8s_service_account = "healing-specialist"
sqs_healing_queue_prefix        = "specialist"

# RDS PostgreSQL — Multi-AZ, keep final snapshot, deletion protection, with proxy
rds_db_name             = "healing_specialist_db"
rds_username            = "REPLACE-WITH-DB-USERNAME"
rds_password            = "REPLACE-WITH-STRONG-PASSWORD"
rds_engine_version      = "17"
rds_instance_class      = "db.t3.medium"
rds_allocated_storage   = 50
rds_multi_az            = true
rds_skip_final_snapshot = false

# RDS Proxy — connection pooling for production
rds_enable_proxy                      = true
rds_proxy_idle_client_timeout         = 1800
rds_proxy_require_tls                 = true
rds_proxy_max_connections_percent     = 80
rds_proxy_max_idle_connections_percent = 50
rds_proxy_connection_borrow_timeout   = 120
rds_proxy_debug_logging               = false

tags = {
  Team = "platform"
}
