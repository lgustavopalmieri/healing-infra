# Copy this file to production.tfvars and fill in the values.
# NEVER commit the actual .tfvars file — it is already in .gitignore.
#
# Before applying this environment, make sure you have:
#   1. Applied the bootstrap: terraform -chdir=../../bootstrap/production apply -var-file=production.tfvars
#   2. Updated the backend block in main.tf with the bootstrap outputs

project_name = "myapp"
environment  = "production"
cluster_name = "myapp-production"
aws_region   = "us-east-1"

# Networking
vpc_cidr           = "10.0.0.0/16"
single_nat_gateway = false

# EKS
kubernetes_version  = "1.35"
node_instance_types = ["t3.medium"]
node_min_size       = 3
node_max_size       = 6
node_desired_size   = 3

# ECR
ecr_repository_name = "my-app"
ecr_force_delete    = false

# GitHub OIDC
github_org   = "my-github-org"
github_repos = ["my-repo"]

# DNS — get shared_state_bucket from: terraform -chdir=../../bootstrap/shared output
shared_state_bucket = "myapp-shared-terraform-state"
dns_records         = ["api.myapp.com"]

# Elastic Cloud
ec_api_key           = "REPLACE-WITH-YOUR-ELASTIC-CLOUD-API-KEY"
es_deployment_name   = "myapp-production"
es_region            = "us-east-1"
es_size              = "8g"
es_zone_count        = 2
es_kibana_size       = "2g"
es_app_user_name     = "app_user"
es_app_user_password = "REPLACE-WITH-STRONG-PASSWORD"

# PrivateLink — Elastic Cloud
# Service name and PHZ domain for your region. Full list at:
# https://www.elastic.co/guide/en/cloud/current/ec-traffic-filtering-vpc.html
elastic_privatelink_service_name = "com.amazonaws.vpce.us-east-1.vpce-svc-0e42e1e06ed010238"
elastic_privatelink_phz_domain   = "vpce.us-east-1.aws.elastic-cloud.com"

# RDS PostgreSQL
rds_db_name           = "healing_specialist_db"
rds_username          = "REPLACE-WITH-DB-USERNAME"
rds_password          = "REPLACE-WITH-STRONG-PASSWORD"
rds_engine_version    = "17"
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 10
rds_multi_az          = true
rds_skip_final_snapshot = false

# Kafka (Confluent Cloud)
confluent_api_key              = "REPLACE-WITH-CONFLUENT-API-KEY"
confluent_api_secret           = "REPLACE-WITH-CONFLUENT-API-SECRET"
kafka_environment_name         = "myapp-production"
kafka_cluster_name             = "myapp-production-kafka"
kafka_region                   = "us-east-1"
kafka_cluster_type             = "basic"
kafka_app_service_account_name = "app-service-account"
kafka_app_topic_name           = "app-events"
kafka_app_topic_partitions     = 3

tags = {
  Team = "platform"
}
