# Copy this file to terraform.tfvars and fill in the values.
# NEVER commit the actual .tfvars file — it is already in .gitignore.
#
# Dev environment — mirrors production stack but with lightweight config.
# No custom DNS — access the ALB via the AWS-generated hostname.
# Designed for fast spin-up and teardown (terraform destroy).
#
# Before applying, bootstrap the state backend:
#   cd ../../bootstrap/dev
#   terraform init
#   terraform apply -var-file=dev.tfvars
#   # Copy outputs into environments/dev/main.tf backend block (if not done already)

project_name = "healing"
environment  = "dev"
cluster_name = "healing-dev"
aws_region   = "us-east-1"

# Networking — single NAT to save cost
vpc_cidr           = "10.0.0.0/16"
single_nat_gateway = true

# EKS — minimal nodes
kubernetes_version  = "1.35"
node_instance_types = ["t3.medium"]
node_min_size       = 1
node_max_size       = 3
node_desired_size   = 1

# ECR — force delete for easy teardown
ecr_repository_name = "REPLACE-WITH-YOUR-ECR-REPO"
ecr_force_delete    = true

# GitHub OIDC
github_org   = "REPLACE-WITH-YOUR-GITHUB-ORG"
github_repos = ["REPLACE-WITH-YOUR-REPO"]

# OpenSearch — single small node
opensearch_engine_version             = "OpenSearch_2.17"
opensearch_instance_type              = "t3.small.search"
opensearch_instance_count             = 1
opensearch_ebs_volume_size            = 20
opensearch_zone_awareness_enabled     = false
opensearch_dedicated_master_enabled   = false
opensearch_create_service_linked_role = false  # set to true ONLY if the SLR doesn't exist yet in your account

# SQS / Workload Identity — Healing Specialist
sqs_healing_k8s_namespace       = "healing"
sqs_healing_k8s_service_account = "healing-specialist"
sqs_healing_queue_prefix        = "specialist"

# RDS PostgreSQL — smallest, no HA, skip snapshot for easy destroy
rds_db_name             = "healing_specialist_db"
rds_username            = "REPLACE-WITH-DB-USERNAME"
rds_password            = "REPLACE-WITH-STRONG-PASSWORD"
rds_engine_version      = "17"
rds_instance_class      = "db.t3.micro"
rds_allocated_storage   = 10
rds_multi_az            = false
rds_skip_final_snapshot = true

tags = {
  Team = "platform"
}
